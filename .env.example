# ─── Banco de dados (Neon PostgreSQL) ────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Blockchain APIs ──────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=""
HELIUS_API_KEY=""
TRONGRID_API_KEY=""

# ─── Pricing APIs ─────────────────────────────────────────────────────────────
COINGECKO_API_KEY=""

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Necessário em produção (Vercel). Sem isso o rate limiter usa memória local
# e não funciona entre múltiplas instâncias serverless.
# Crie um banco em https://console.upstash.com e copie as credenciais REST.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
